// DispatchDesk database schema (SQLite via Prisma).
// String "enum" columns are validated in the application layer (see src/lib/constants.js).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// ---------------------------------------------------------------------------
// Identity, RBAC, sessions
// ---------------------------------------------------------------------------

model Role {
  id          Int              @id @default(autoincrement())
  key         String           @unique // super_admin | admin | team_manager | dispatcher | user
  name        String
  description String?
  rank        Int              @default(0)
  permissions RolePermission[]
  users       User[]
}

model Permission {
  id          Int              @id @default(autoincrement())
  key         String           @unique
  description String?
  roles       RolePermission[]
}

model RolePermission {
  roleId       Int
  permissionId Int
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  passwordHash      String
  name              String
  phone             String?
  bio               String?
  avatarPath        String?
  roleId            Int
  status            String    @default("active") // active | suspended
  emailVerifiedAt   DateTime?
  theme             String    @default("system") // light | dark | system
  timezone          String    @default("America/Chicago")
  emailSignature    String?
  mailingAddress    String? // physical postal address printed in the email footer (CAN-SPAM)
  notifyEmail       Boolean   @default(true)
  notifyInApp       Boolean   @default(true)
  notifyFollowUps   Boolean   @default(true)
  notifyCommunity   Boolean   @default(true)
  lastLoginAt       DateTime?
  tourState         String    @default("{}") // JSON: onboarding tours completed
  calendarTokenHash String?   @unique // private iCalendar feed (sha256 of the token)
  notifyPush        Boolean   @default(true)
  notifyDigest      Boolean   @default(true) // one daily email digest instead of per-reminder emails
  pushPrefs         String? // JSON { "<notification type>": false } per type; a missing type is on
  companyName       String? // fills {{my_company}} in templates for users without a team
  agreementTemplate String? // last dispatch agreement text used for onboarding links
  googleSub         String?   @unique // Google account id ("sub") linked for Continue with Google
  invoiceLogo       String? // stored file name of the logo printed on invoices and statements
  aiProvider        String? // BYOK: openai (OpenAI-compatible) | anthropic; null = use the platform AI
  aiBaseUrl         String? // BYOK: base URL for OpenAI-compatible providers
  aiModel           String? // BYOK: model id
  aiKeyEnc          String? // BYOK: encrypted API key
  aiKeyHint         String? // BYOK: last 4 characters, for display
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  role               Role                  @relation(fields: [roleId], references: [id])
  sessions           Session[]
  tokens             AuthToken[]
  teamMembership     TeamMember?
  ownedTeams         Team[]                @relation("TeamOwner")
  sentInvitations    Invitation[]          @relation("InvitedBy")
  subscriptions      Subscription[]
  payments           Payment[]
  carriers           Carrier[]             @relation("CarrierOwner")
  assignedCarriers   Carrier[]             @relation("CarrierAssignee")
  carrierNotes       CarrierNote[]
  tags               Tag[]
  opportunities      Opportunity[]
  customers          Customer[]
  calls              Call[]
  emailAccounts      EmailAccount[]
  emails             Email[]
  emailTemplates     EmailTemplate[]
  emailSequences     EmailSequence[]
  enrollments        SequenceEnrollment[]
  followUps          FollowUp[]
  activities         Activity[]
  brokers            Broker[]
  loads              Load[]
  callSettings       CallSettings?
  callAttempts       CallAttempt[]
  callScripts        CallScript[]
  apiTokens          ApiToken[]
  leadGenerators     LeadGenerator[]
  leadGenRuns        LeadGenRun[]
  locationShares     LocationShare[]
  textTemplates      TextTemplate[]
  pushSubscriptions  PushSubscription[]
  invoices           Invoice[]
  loadEvents         LoadEvent[]
  loadShares         LoadShare[]
  documents          Document[]            @relation("DocumentOwner")
  onboardingLinks    OnboardingLink[]
  carrierShares      CarrierShare[]
  loadTemplates      LoadTemplate[]
  consolidations     Consolidation[]
  aiUsage            AiUsageEvent[]
  contactConsents    ContactConsent[]
  negotiations       Negotiation[]
  factoringCompanies FactoringCompany[]
  uploadedDocuments  Document[]            @relation("DocumentUploader")
  trainingCourses    TrainingCourse[]
  trainingProgress   TrainingProgress[]
  trainingRequests   TrainingRequest[]
  trainerThread      TrainerMessage[]      @relation("TrainerThread")
  trainerAuthored    TrainerMessage[]      @relation("TrainerAuthor")
  listings           MarketplaceListing[]
  sentMarketMessages MarketplaceMessage[]  @relation("MarketSender")
  recvMarketMessages MarketplaceMessage[]  @relation("MarketRecipient")
  posts              CommunityPost[]
  comments           CommunityComment[]
  reports            ContentReport[]       @relation("Reporter")
  resolvedReports    ContentReport[]       @relation("Resolver")
  aiConversations    AIConversation[]
  knowledgeDocuments AIKnowledgeDocument[]
  automations        Automation[]
  notifications      Notification[]
  auditLogs          AuditLog[]
  suppressions       EmailSuppression[]
  prospectLists      ProspectList[]
  settingsUpdated    SystemSetting[]

  @@index([roleId])
  @@index([createdAt])
  @@index([timezone])
}

model Session {
  id         String   @id // sha256 of the cookie token
  userId     String
  expiresAt  DateTime
  lastSeenAt DateTime @default(now())
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model AuthToken {
  id        String    @id @default(cuid())
  userId    String
  type      String // verify_email | reset_password
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

// ---------------------------------------------------------------------------
// Teams
// ---------------------------------------------------------------------------

model Team {
  id                 String         @id @default(cuid())
  name               String
  ownerId            String
  leaderboardEnabled Boolean        @default(true)
  managersSeeAll     Boolean        @default(true)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  owner              User           @relation("TeamOwner", fields: [ownerId], references: [id])
  members            TeamMember[]
  invitations        Invitation[]
  subscriptions      Subscription[]
  activities         Activity[]

  @@index([ownerId])
}

model TeamMember {
  id               String   @id @default(cuid())
  teamId           String
  userId           String   @unique // one team per user
  role             String   @default("dispatcher") // owner | manager | dispatcher
  canViewTeamData  Boolean  @default(false)
  canManageMembers Boolean  @default(false)
  joinedAt         DateTime @default(now())
  team             Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([teamId])
}

model Invitation {
  id          String    @id @default(cuid())
  teamId      String
  email       String
  role        String    @default("dispatcher")
  tokenHash   String    @unique
  invitedById String
  status      String    @default("pending") // pending | accepted | revoked | expired
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())
  team        Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  invitedBy   User      @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([teamId, status])
  @@index([email])
}

// ---------------------------------------------------------------------------
// Billing
// ---------------------------------------------------------------------------

model Plan {
  id                  Int            @id @default(autoincrement())
  key                 String         @unique // free | pro | annual | teams | company
  name                String
  description         String?
  priceCents          Int            @default(0)
  basePriceCents      Int            @default(0) // flat fee on top of per-seat (company)
  interval            String         @default("month") // month | year
  perSeat             Boolean        @default(false)
  minSeats            Int            @default(1)
  trialDays           Int            @default(0)
  stripePriceId       String?
  stripeBasePriceId   String?
  maxCarriers         Int            @default(500)
  dailyEmailLimit     Int            @default(20)
  monthlyAiMessages   Int            @default(30)
  maxSequences        Int            @default(1)
  maxAutomations      Int            @default(0)
  maxDiscoveryPerDay  Int            @default(100)
  monthlyLeadGenLimit Int            @default(50) // leads the lead generator may create per month
  maxLeadGenerators   Int            @default(1)
  leadGenAutoRun      Boolean        @default(false) // scheduled (daily/weekly) generator runs
  advancedReports     Boolean        @default(false)
  trainingIncluded    Boolean        @default(false)
  teamFeatures        Boolean        @default(false)
  active              Boolean        @default(true)
  sortOrder           Int            @default(0)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  subscriptions       Subscription[]
}

model Subscription {
  id                   String    @id @default(cuid())
  userId               String
  teamId               String?
  planId               Int
  status               String // incomplete | trialing | active | past_due | canceled | unpaid
  seats                Int       @default(1)
  stripeCustomerId     String?
  stripeSubscriptionId String?   @unique
  stripeCheckoutId     String?   @unique
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  trialEndsAt          DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)
  canceledAt           DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  team                 Team?     @relation(fields: [teamId], references: [id], onDelete: SetNull)
  plan                 Plan      @relation(fields: [planId], references: [id])
  payments             Payment[]

  @@index([userId, status])
  @@index([teamId])
}

model Payment {
  id              String        @id @default(cuid())
  userId          String
  subscriptionId  String?
  stripeInvoiceId String?       @unique
  amountCents     Int
  currency        String        @default("usd")
  status          String // paid | open | void | uncollectible | failed
  description     String?
  invoiceUrl      String?
  invoicePdf      String?
  periodStart     DateTime?
  periodEnd       DateTime?
  paidAt          DateTime?
  createdAt       DateTime      @default(now())
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription    Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}

model StripeEvent {
  id          String   @id // Stripe event id, for idempotency
  type        String
  processedAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// CRM core
// ---------------------------------------------------------------------------

model PipelineStage {
  id        Int       @id @default(autoincrement())
  key       String    @unique // lead | prospecting | sequence | opportunity | trial | customer | archived
  name      String
  sortOrder Int
  color     String    @default("#64748b")
  carriers  Carrier[]
}

model Carrier {
  id                String    @id @default(cuid())
  ownerId           String
  assignedToId      String?
  stageId           Int
  companyName       String
  dbaName           String?
  dotNumber         String?
  mcNumber          String?
  phone             String?
  email             String?
  address           String?
  city              String?
  state             String?
  zip               String?
  equipment         String? // comma separated: dry_van, reefer, flatbed, step_deck, power_only, hotshot, box_truck, tanker, car_hauler, other
  fleetSize         Int?
  drivers           Int?
  authorityStatus   String? // active | inactive | pending | unknown
  authorityDate     DateTime?
  operatingStatus   String?
  classification    String?
  carrierOperation  String?
  source            String    @default("manual") // manual | csv | fmcsa_census | fmcsa_qc
  sourceRef         String?
  verifiedAt        DateTime?
  timezone          String?
  doNotCall         Boolean   @default(false)
  doNotEmail        Boolean   @default(false)
  truckStatus       String    @default("unknown") // unknown | available | loaded | off_duty | maintenance
  locationCity      String?
  locationState     String?
  locationLat       Float?
  locationLng       Float?
  locationUpdatedAt DateTime?
  availableAt       DateTime?
  locationSource    String? // manual | driver_link | eld
  isFleet           Boolean   @default(false) // customer, or has a truck location/trip: shown on the fleet map
  fmcsaSnapshot     String? // JSON: last FMCSA authority/insurance/contact snapshot (watchlist)
  fmcsaCheckedAt    DateTime?
  priority          Int       @default(0) // 0 normal, 1 high, 2 hot
  // Lead score v2 (services/carriers/leadSignals.js): 0-100, tier A | B | C, JSON [{ key, label, points, group, tone }]
  leadScore         Int?
  leadTier          String?
  leadSignals       String?
  lastContactedAt   DateTime?
  nextFollowUpAt    DateTime?
  stageChangedAt    DateTime  @default(now())
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  owner           User                 @relation("CarrierOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  assignedTo      User?                @relation("CarrierAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  stage           PipelineStage        @relation(fields: [stageId], references: [id])
  contacts        CarrierContact[]
  notes           CarrierNote[]
  tags            CarrierTag[]
  opportunity     Opportunity?
  customer        Customer?
  calls           Call[]
  callAttempts    CallAttempt[]
  emails          Email[]
  enrollments     SequenceEnrollment[]
  followUps       FollowUp[]
  activities      Activity[]
  loads           Load[]
  documents       Document[]
  onboardingLinks OnboardingLink[]
  carrierShares   CarrierShare[]
  contactConsents ContactConsent[]
  negotiations    Negotiation[]
  listItems       ProspectListItem[]
  locationShares  LocationShare[]
  invoices        Invoice[]

  @@unique([ownerId, dotNumber])
  @@unique([ownerId, mcNumber])
  @@index([ownerId, stageId])
  @@index([ownerId, companyName])
  @@index([ownerId, phone])
  @@index([assignedToId])
  @@index([state])
  @@index([ownerId, createdAt])
  @@index([ownerId, isFleet])
  @@index([ownerId, email])
  @@index([ownerId, leadScore])
}

model CarrierContact {
  id        String   @id @default(cuid())
  carrierId String
  name      String
  title     String?
  phone     String?
  email     String?
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  carrier   Carrier  @relation(fields: [carrierId], references: [id], onDelete: Cascade)

  @@index([carrierId])
  @@index([email])
}

model CarrierNote {
  id        String   @id @default(cuid())
  carrierId String
  authorId  String
  body      String
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  carrier   Carrier  @relation(fields: [carrierId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([carrierId, createdAt])
  @@index([authorId])
}

model Tag {
  id        String       @id @default(cuid())
  ownerId   String
  name      String
  color     String       @default("#2563eb")
  createdAt DateTime     @default(now())
  owner     User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  carriers  CarrierTag[]

  @@unique([ownerId, name])
}

model CarrierTag {
  carrierId String
  tagId     String
  carrier   Carrier @relation(fields: [carrierId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([carrierId, tagId])
  @@index([tagId])
}

model ProspectList {
  id          String             @id @default(cuid())
  ownerId     String
  name        String
  description String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  owner       User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  items       ProspectListItem[]

  @@unique([ownerId, name])
}

model ProspectListItem {
  listId    String
  carrierId String
  addedAt   DateTime     @default(now())
  list      ProspectList @relation(fields: [listId], references: [id], onDelete: Cascade)
  carrier   Carrier      @relation(fields: [carrierId], references: [id], onDelete: Cascade)

  @@id([listId, carrierId])
  @@index([carrierId])
}

model Opportunity {
  id                  String    @id @default(cuid())
  carrierId           String    @unique
  ownerId             String
  status              String    @default("open") // open | negotiating | trial | won | lost
  estimatedValueCents Int       @default(0) // estimated monthly dispatch revenue
  dispatchFeePercent  Float?
  probability         Int       @default(25)
  nextFollowUpAt      DateTime?
  notes               String?
  lostReason          String?
  trialStartedAt      DateTime?
  closedAt            DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  carrier             Carrier   @relation(fields: [carrierId], references: [id], onDelete: Cascade)
  owner               User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId, status])
}

model Customer {
  id                  String            @id @default(cuid())
  carrierId           String            @unique
  ownerId             String
  status              String            @default("active") // active | paused | churned
  signedAt            DateTime          @default(now())
  dispatchFeePercent  Float?
  minRatePerMile      Float?
  maxDeadheadMiles    Int?
  homeBase            String?
  maxWeightLbs        Int?
  trailerLengthFt     Int?
  hazmat              Boolean           @default(false)
  twic                Boolean           @default(false)
  teamDrivers         Boolean           @default(false)
  avoidStates         String? // comma-separated state codes
  homeTimeDays        String? // e.g. 'Sat,Sun' (days the truck is home)
  costPerMileCents    Int?
  minHaulMiles        Int?
  maxHaulMiles        Int?
  portalTokenHash     String?           @unique // carrier statement/portal link (sha256)
  portalExpiresAt     DateTime?
  notes               String?
  // Factoring: who buys this carrier's invoices and on what terms (null company = the carrier does not factor).
  factoringCompanyId  String?
  factoringClientNo   String? // the carrier's account / client number at the factoring company
  factoringAdvancePct Float? // percent of the invoice advanced up front, e.g. 90
  factoringFeePct     Float? // factoring fee in percent of the invoice, e.g. 3
  factoringRecourse   Boolean? // true = recourse, false = non-recourse, null = not recorded
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  carrier             Carrier           @relation(fields: [carrierId], references: [id], onDelete: Cascade)
  owner               User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  lanes               CustomerLane[]
  factoringCompany    FactoringCompany? @relation(fields: [factoringCompanyId], references: [id], onDelete: SetNull)

  @@index([ownerId, status])
  @@index([factoringCompanyId])
}

/// A factoring company the dispatcher's carriers use. Kept per owner and shared by that owner's carriers.
model FactoringCompany {
  id          String     @id @default(cuid())
  ownerId     String
  name        String
  submitEmail String? // where invoice packets (invoice, rate confirmation, BOL, POD) are emailed
  remitTo     String? // remit-to block printed on freight invoices under a notice of assignment
  phone       String?
  website     String?
  notes       String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  owner       User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  customers   Customer[]

  @@index([ownerId])
}

model CustomerLane {
  id          String   @id @default(cuid())
  customerId  String
  origin      String
  destination String
  notes       String?
  createdAt   DateTime @default(now())
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

model Call {
  id          String        @id @default(cuid())
  carrierId   String
  userId      String
  outcome     String // no_answer | busy | voicemail | interested | not_interested | call_back | follow_up | converted
  notes       String?
  durationSec Int?
  calledAt    DateTime      @default(now())
  provider    String? // provider used to place the call (tel, google_voice, twilio, ...)
  carrier     Carrier       @relation(fields: [carrierId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  attempts    CallAttempt[]

  @@index([userId, calledAt])
  @@index([carrierId, calledAt])
}

// ---------------------------------------------------------------------------
// Telephony, scripts and API tokens
// ---------------------------------------------------------------------------

/**
 * Per-user click-to-call configuration. Twilio credentials are AES-GCM encrypted.
 */
model CallSettings {
  id                  String   @id @default(cuid())
  userId              String   @unique
  provider            String   @default("tel") // tel | google_voice | teams | zoom_phone | ringcentral | dialpad | eight_by_eight | callto | sip | custom | twilio
  urlTemplate         String? // custom provider: e.g. https://example.com/dial?n={number}
  myNumber            String? // the dispatcher's own phone (Twilio rings this first)
  callerId            String? // Twilio verified/owned number shown to the carrier
  twilioAccountSid    String?
  twilioAuthTokenEnc  String?
  autoOpenLog         Boolean  @default(true) // open the log-call form as soon as a call starts
  autoAdvance         Boolean  @default(true) // power dialer moves to the next carrier after logging
  enforceCallingHours Boolean  @default(true) // block dialing outside 8:00–19:00 carrier local time
  autoLogUnanswered   Boolean  @default(true) // bridge calls: auto-log no-answer/busy outcomes
  defaultScriptId     String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/**
 * One dial action. Link providers stop at "dialed"; bridge providers (Twilio) report real status by webhook.
 */
model CallAttempt {
  id             String    @id @default(cuid())
  userId         String
  carrierId      String?
  callId         String?
  provider       String
  toNumber       String
  status         String    @default("dialed") // dialed | queued | ringing | in_progress | completed | no_answer | busy | failed | canceled
  providerCallId String?   @unique
  answeredAt     DateTime?
  endedAt        DateTime?
  durationSec    Int?
  error          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  carrier        Carrier?  @relation(fields: [carrierId], references: [id], onDelete: SetNull)
  call           Call?     @relation(fields: [callId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([carrierId])
  @@index([callId])
}

model CallScript {
  id        String   @id @default(cuid())
  ownerId   String
  name      String
  category  String   @default("cold_call") // cold_call | follow_up | voicemail | objection | onboarding | broker
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
}

/**
 * Personal access token for the browser extension / integrations. Only the sha256 is stored.
 */
model ApiToken {
  id         String    @id @default(cuid())
  userId     String
  name       String
  prefix     String // first characters, shown in the UI to identify the token
  tokenHash  String    @unique
  lastUsedAt DateTime?
  expiresAt  DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model FollowUp {
  id                  String    @id @default(cuid())
  carrierId           String
  userId              String
  dueAt               DateTime
  type                String    @default("call") // call | email | text | task | meeting
  title               String?
  note                String?
  priority            Int       @default(0) // 0 normal | 1 high | 2 urgent
  recurrence          String    @default("none") // none | daily | weekdays | weekly | biweekly | monthly
  remindMinutesBefore Int       @default(0)
  status              String    @default("pending") // pending | done | canceled
  outcome             String? // what happened, recorded on completion
  snoozeCount         Int       @default(0)
  completedAt         DateTime?
  notifiedAt          DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  carrier             Carrier   @relation(fields: [carrierId], references: [id], onDelete: Cascade)
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, dueAt])
  @@index([carrierId])
  @@index([status, notifiedAt, dueAt])
}

model Activity {
  id        String   @id @default(cuid())
  userId    String
  carrierId String?
  teamId    String?
  type      String // call | email | note | stage_change | follow_up | document | carrier_created | import | opportunity | customer | load | sequence | ai
  summary   String
  metadata  String? // small JSON payload for display only
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  carrier   Carrier? @relation(fields: [carrierId], references: [id], onDelete: Cascade)
  team      Team?    @relation(fields: [teamId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([carrierId, createdAt])
  @@index([teamId, createdAt])
  @@index([type, createdAt])
}

// ---------------------------------------------------------------------------
// Email
// ---------------------------------------------------------------------------

model EmailAccount {
  id              String    @id @default(cuid())
  userId          String
  provider        String // smtp | hostinger | gmail | outlook
  label           String
  fromEmail       String
  fromName        String?
  smtpHost        String?
  smtpPort        Int?
  smtpSecure      Boolean   @default(true)
  smtpUser        String?
  secretEnc       String? // AES-256-GCM encrypted password or OAuth refresh token
  accessTokenEnc  String?
  tokenExpiresAt  DateTime?
  status          String    @default("connected") // connected | error | disconnected
  lastError       String?
  lastVerifiedAt  DateTime?
  dailyLimit      Int       @default(50)
  cooldownSeconds Int       @default(30)
  lastSentAt      DateTime?
  sentDay         String? // YYYY-MM-DD the counter below belongs to
  sentToday       Int       @default(0)
  imapEnabled     Boolean   @default(false)
  imapHost        String?
  imapPort        Int?
  imapSecure      Boolean   @default(true)
  imapLastUid     Int?
  imapCheckedAt   DateTime?
  imapError       String?
  isDefault       Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  emails          Email[]

  @@index([userId])
  @@index([imapEnabled, status])
}

model EmailTemplate {
  id         String         @id @default(cuid())
  ownerId    String
  name       String
  subject    String
  body       String
  category   String         @default("carrier") // carrier | broker | follow_up | other
  useCount   Int            @default(0)
  lastUsedAt DateTime?
  starterKey String? // set when installed from a starter pack (prevents duplicates)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  owner      User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  steps      SequenceStep[]
  emails     Email[]

  @@index([ownerId])
  @@index([ownerId, starterKey])
}

model Email {
  id                String              @id @default(cuid())
  userId            String
  carrierId         String?
  brokerId          String?
  emailAccountId    String?
  templateId        String?
  enrollmentId      String?
  toEmail           String
  subject           String
  body              String
  status            String              @default("draft") // draft | scheduled | sending | sent | failed | canceled
  providerMessageId String?
  error             String?
  attempts          Int                 @default(0)
  scheduledAt       DateTime?
  nextAttemptAt     DateTime?
  sentAt            DateTime?
  messageId         String? // Message-ID header we generated (reply threading)
  repliedAt         DateTime?
  negotiationId     String?
  bouncedAt         DateTime?
  bounceReason      String?
  attachments       String? // JSON [{documentId, name, size}] sent with this email
  aiGenerated       Boolean             @default(false)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  carrier           Carrier?            @relation(fields: [carrierId], references: [id], onDelete: SetNull)
  broker            Broker?             @relation(fields: [brokerId], references: [id], onDelete: SetNull)
  emailAccount      EmailAccount?       @relation(fields: [emailAccountId], references: [id], onDelete: SetNull)
  template          EmailTemplate?      @relation(fields: [templateId], references: [id], onDelete: SetNull)
  enrollment        SequenceEnrollment? @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)

  @@index([userId, status, sentAt])
  @@index([status, scheduledAt])
  @@index([carrierId])
  @@index([enrollmentId, createdAt])
  @@index([emailAccountId, status, sentAt])
  @@index([templateId])
  @@index([brokerId])
  @@index([userId, updatedAt])
  @@index([messageId])
  @@index([userId, repliedAt])
  @@index([negotiationId])
  @@index([userId, aiGenerated, status])
}

model EmailSuppression {
  id        String   @id @default(cuid())
  ownerId   String
  email     String
  reason    String   @default("manual") // manual | unsubscribed | bounced
  createdAt DateTime @default(now())
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@unique([ownerId, email])
}

model EmailSequence {
  id                   String               @id @default(cuid())
  ownerId              String
  name                 String
  description          String?
  active               Boolean              @default(true)
  respectBusinessHours Boolean              @default(true)
  windowStartHour      Int                  @default(9)
  windowEndHour        Int                  @default(17)
  skipWeekends         Boolean              @default(true)
  maxEmailsPerDay      Int                  @default(50)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  owner                User                 @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  steps                SequenceStep[]
  enrollments          SequenceEnrollment[]

  @@index([ownerId])
}

model SequenceStep {
  id           String         @id @default(cuid())
  sequenceId   String
  order        Int
  dayOffset    Int
  type         String // call | email | task
  templateId   String?
  subject      String?
  body         String?
  instructions String?
  aiMode       String? // email steps: null/off = template | auto = AI writes and sends | review = AI writes, user approves
  aiBrief      String? // what the AI email should say (goal, offer, tone)
  sequence     EmailSequence  @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  template     EmailTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@unique([sequenceId, order])
}

model SequenceEnrollment {
  id          String        @id @default(cuid())
  sequenceId  String
  carrierId   String
  userId      String
  status      String        @default("active") // active | paused | completed | stopped
  currentStep Int           @default(0) // index into ordered steps
  nextStepAt  DateTime?
  startedAt   DateTime      @default(now())
  completedAt DateTime?
  stopReason  String?
  sequence    EmailSequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  carrier     Carrier       @relation(fields: [carrierId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  emails      Email[]

  @@unique([sequenceId, carrierId])
  @@index([userId, status, nextStepAt])
  @@index([carrierId, status])
  @@index([status, nextStepAt])
}

// ---------------------------------------------------------------------------
// Brokers, loads, documents
// ---------------------------------------------------------------------------

model Broker {
  id               String        @id @default(cuid())
  ownerId          String
  negotiations     Negotiation[]
  companyName      String
  contactName      String?
  email            String?
  phone            String?
  address          String?
  city             String?
  state            String?
  zip              String?
  mcNumber         String?
  dotNumber        String?
  paymentTerms     String? // e.g. Net 30, Quick pay 2%
  daysToPay        Int?
  creditRating     String?
  creditLimitCents Int?
  fmcsaSnapshot    String? // JSON: authority, bond/insurance on file, contact info, added date
  fmcsaCheckedAt   DateTime?
  flags            String? // JSON array of red flags with reasons and sources
  watch            Boolean       @default(false)
  notes            String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  owner            User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  loads            Load[]
  emails           Email[]
  invoices         Invoice[]

  @@index([ownerId, companyName])
  @@index([ownerId, mcNumber])
  @@index([watch, id])
}

model Load {
  id                  String         @id @default(cuid())
  ownerId             String
  brokerId            String?
  carrierId           String?
  referenceNumber     String?
  originCity          String
  originState         String
  destCity            String
  destState           String
  originLat           Float?
  originLng           Float?
  destLat             Float?
  destLng             Float?
  pickupDate          DateTime?
  deliveryDate        DateTime?
  pickupWindowStart   DateTime?
  pickupWindowEnd     DateTime?
  deliveryWindowStart DateTime?
  deliveryWindowEnd   DateTime?
  pickupTz            String?
  deliveryTz          String?
  pickupFacility      String?
  pickupAddress       String?
  deliveryFacility    String?
  deliveryAddress     String?
  freeTimeHours       Float          @default(2)
  tonuCents           Int            @default(0)
  fitWarnings         String? // JSON warnings from the carrier-rules check at save time
  fitAckAt            DateTime?
  fitAckById          String?
  routeGeometry       String? // DEPRECATED: moved to LoadRoute.geometry (kept so old rows need no table rebuild; always null now)
  routeMiles          Float?
  routeMinutes        Int?
  routeSource         String? // osrm | estimate
  routeComputedAt     DateTime?
  lastCheckCallAt     DateTime?
  equipment           String?
  commodity           String?
  weightLbs           Int?
  loadedMiles         Int
  deadheadMiles       Int            @default(0)
  rateCents           Int
  detentionHours      Float          @default(0)
  detentionRateCents  Int            @default(0)
  fuelPricePerGallon  Float?
  mpg                 Float?
  otherCostsCents     Int            @default(0)
  dispatchFeePercent  Float?
  status              String         @default("planned") // planned | booked | in_transit | delivered | invoiced | paid | canceled
  notes               String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  owner               User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  broker              Broker?        @relation(fields: [brokerId], references: [id], onDelete: SetNull)
  carrier             Carrier?       @relation(fields: [carrierId], references: [id], onDelete: SetNull)
  documents           Document[]
  events              LoadEvent[]
  shares              LoadShare[]
  invoices            Invoice[]
  route               LoadRoute?
  consolidationId     String?
  consolidation       Consolidation? @relation(fields: [consolidationId], references: [id], onDelete: SetNull)
  templateId          String? // LoadTemplate that generated this load (recurring lanes)

  @@index([ownerId, status])
  @@index([brokerId])
  @@index([carrierId])
  @@index([ownerId, originState, destState])
  @@index([ownerId, pickupDate])
  @@index([ownerId, deliveryDate])
  @@index([ownerId, referenceNumber])
  @@index([consolidationId])
  @@index([templateId, pickupDate])
}

model Document {
  id           String           @id @default(cuid())
  ownerId      String
  uploadedById String
  carrierId    String?
  loadId       String?
  type         String // agreement | mc_authority | w9 | coi | permit | rate_confirmation | bol | pod | other
  originalName String
  storedName   String           @unique
  mimeType     String
  sizeBytes    Int
  expiresAt    DateTime?
  source       String? // upload | driver_link | portal | email
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  owner        User             @relation("DocumentOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  uploadedBy   User             @relation("DocumentUploader", fields: [uploadedById], references: [id], onDelete: Cascade)
  carrier      Carrier?         @relation(fields: [carrierId], references: [id], onDelete: Cascade)
  load         Load?            @relation(fields: [loadId], references: [id], onDelete: Cascade)
  sharedFrom   CarrierShareDoc?

  @@index([ownerId])
  @@index([carrierId])
  @@index([loadId])
  @@index([uploadedById])
  @@index([expiresAt])
}

/// Road route geometry for a load, kept out of the Load row so load lists and joins stay small.
model LoadRoute {
  loadId    String   @id
  geometry  String // encoded polyline (pickup -> delivery)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  load      Load     @relation(fields: [loadId], references: [id], onDelete: Cascade)
}

/// Carrier onboarding link: the carrier reads and e-signs the dispatch agreement and uploads W9 / COI / MC authority.
/// Only the sha256 of the token is stored. The signed text is snapshotted with its hash for the audit trail.
model OnboardingLink {
  id              String    @id @default(cuid())
  ownerId         String
  carrierId       String
  tokenHash       String    @unique
  status          String    @default("pending") // pending | signed | revoked
  agreementTitle  String
  agreementBody   String // exact text shown to the carrier
  agreementHash   String // sha256 of agreementBody
  feePercent      Float?
  requestedDocs   String? // comma list: w9,coi,mc_authority,voided_check
  viewedAt        DateTime?
  consentAt       DateTime? // agreed to sign electronically (ESIGN / UETA)
  signerName      String?
  signerTitle     String?
  signerEmail     String?
  signatureData   String? // typed name, or a drawn signature as compact SVG path data
  signedAt        DateTime?
  signerIp        String?
  signerUserAgent String?
  expiresAt       DateTime
  revokedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  owner           User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  carrier         Carrier   @relation(fields: [carrierId], references: [id], onDelete: Cascade)

  @@index([ownerId, status])
  @@index([carrierId])
}

/// Saved load template; with a recurrence it becomes a dedicated lane that generates planned loads ahead of time.
model LoadTemplate {
  id          String    @id @default(cuid())
  ownerId     String
  name        String
  fields      String // JSON of load fields (lane, facilities, rate, equipment, carrierId, brokerId, windows as local times)
  carrierId   String?
  brokerId    String?
  weekdays    String? // recurrence: comma list of 0-6 (Sun-Sat) in the pickup time zone; null = template only
  pickupTime  String? // "HH:MM" local pickup time for generated loads
  leadDays    Int       @default(7) // generate loads this many days ahead
  active      Boolean   @default(true)
  generatedTo DateTime? // loads exist up to this date (exclusive), so the job never makes duplicates
  lastRunAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  owner       User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId, active])
  @@index([active, generatedTo])
}

/// Consolidated trip: two or more loads (customers) on one truck, each still billed and documented on its own load.
model Consolidation {
  id              String    @id @default(cuid())
  ownerId         String
  carrierId       String
  name            String?
  status          String    @default("planned") // planned | in_transit | delivered | canceled
  stops           String // JSON ordered stops [{ loadId, kind: 'pickup' | 'delivery' }]
  routeGeometry   String? // encoded polyline through every stop, in order
  routeMiles      Float?
  routeMinutes    Int?
  routeComputedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  owner           User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  loads           Load[]

  @@index([ownerId, status])
  @@index([carrierId, status])
}

/// One AI call charged to a user (platform key) or made with the user's own key (BYOK), for quotas and cost reports.
model AiUsageEvent {
  id           String   @id @default(cuid())
  userId       String
  purpose      String // chat | draft_email | call_script | objection | analyze_load | sequence_email | negotiation | other
  byok         Boolean  @default(false)
  provider     String? // openai | anthropic
  model        String?
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  ok           Boolean  @default(true)
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, byok, createdAt])
  @@index([createdAt])
}

/// Consent to automated calls / texts (TCPA). Proof is kept: exact text shown, its hash, when, how, IP and device.
model ContactConsent {
  id               String    @id @default(cuid())
  ownerId          String
  carrierId        String
  phone            String // E.164-ish digits the consent covers
  channels         String // comma list: sms,voice
  consentText      String // exact wording the person agreed to
  consentHash      String // sha256 of consentText
  source           String // onboarding | manual | form
  onboardingLinkId String?
  grantedAt        DateTime  @default(now())
  grantedByName    String?
  ip               String?
  userAgent        String?
  proofDocumentId  String? // optional uploaded proof for manual consents
  note             String?
  revokedAt        DateTime?
  revokeReason     String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  owner            User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  carrier          Carrier   @relation(fields: [carrierId], references: [id], onDelete: Cascade)

  @@index([ownerId, carrierId])
  @@index([carrierId, revokedAt])
  @@index([phone])
}

/// AI-assisted rate negotiation with a broker by email. The dispatcher always approves the final agreement.
model Negotiation {
  id               String   @id @default(cuid())
  ownerId          String
  brokerId         String
  carrierId        String?
  loadId           String?
  emailAccountId   String?
  toEmail          String
  status           String   @default("active") // draft | active | needs_review | agreed | walked_away | canceled
  mode             String   @default("approve") // approve = every email waits for the dispatcher | auto = counters inside the limits go out automatically
  lane             String // JSON { originCity, originState, destCity, destState, pickupDate, equipment, weightLbs, miles, reference }
  offerCents       Int? // broker's latest offer
  targetCents      Int // what the dispatcher wants
  floorCents       Int // walk-away: never counter or accept below this
  lastCounterCents Int?
  agreedCents      Int?
  rounds           Int      @default(0)
  maxRounds        Int      @default(3)
  history          String   @default("[]") // JSON [{ at, from: 'broker'|'ai'|'dispatcher', kind, cents, text, emailId }]
  nextAction       String? // JSON proposal waiting for approval { kind: 'counter'|'accept'|'walk_away'|'ask', cents, subject, body }
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  owner            User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  broker           Broker   @relation(fields: [brokerId], references: [id], onDelete: Cascade)
  carrier          Carrier? @relation(fields: [carrierId], references: [id], onDelete: SetNull)

  @@index([ownerId, status])
  @@index([brokerId])
  @@index([loadId])
}

// ---------------------------------------------------------------------------
// Training
// ---------------------------------------------------------------------------

model TrainingCourse {
  id          String           @id @default(cuid())
  title       String
  slug        String           @unique
  description String?
  category    String           @default("fundamentals") // fundamentals | sales | operations | compliance | tools | business
  level       String           @default("beginner") // beginner | intermediate | advanced
  published   Boolean          @default(false)
  sortOrder   Int              @default(0)
  createdById String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  createdBy   User?            @relation(fields: [createdById], references: [id], onDelete: SetNull)
  lessons     TrainingLesson[]
}

model TrainingLesson {
  id              String             @id @default(cuid())
  courseId        String
  title           String
  content         String             @default("") // markdown
  videoUrl        String?
  attachmentPath  String?
  attachmentName  String?
  durationMinutes Int                @default(10)
  sortOrder       Int                @default(0)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  course          TrainingCourse     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  progress        TrainingProgress[]

  @@index([courseId, sortOrder])
}

model TrainingProgress {
  id          String         @id @default(cuid())
  userId      String
  lessonId    String
  completedAt DateTime       @default(now())
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson      TrainingLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
}

model TrainingRequest {
  id        String   @id @default(cuid())
  userId    String?
  name      String
  email     String
  phone     String?
  message   String?
  status    String   @default("new") // new | contacted | enrolled | closed
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
}

model TrainerMessage {
  id           String    @id @default(cuid())
  threadUserId String // the student whose thread this is
  authorId     String
  fromTrainer  Boolean   @default(false)
  body         String
  readAt       DateTime?
  createdAt    DateTime  @default(now())
  threadUser   User      @relation("TrainerThread", fields: [threadUserId], references: [id], onDelete: Cascade)
  author       User      @relation("TrainerAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([threadUserId, createdAt])
  @@index([authorId])
}

// ---------------------------------------------------------------------------
// Marketplace & community
// ---------------------------------------------------------------------------

model MarketplaceListing {
  id           String               @id @default(cuid())
  sellerId     String
  title        String
  category     String // dispatch_tools | training | software | services | hiring | employment | consulting
  description  String
  priceCents   Int?
  priceType    String               @default("fixed") // fixed | hourly | monthly | free | contact
  location     String?
  contactEmail String?
  websiteUrl   String?
  imagePath    String?
  status       String               @default("active") // active | hidden | removed
  sizeBytes    Int                  @default(0) // stored image bytes, summed for the storage quota
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  seller       User                 @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  messages     MarketplaceMessage[]
  reports      ContentReport[]

  @@index([status, category, createdAt])
  @@index([sellerId])
}

model MarketplaceMessage {
  id          String             @id @default(cuid())
  listingId   String
  senderId    String
  recipientId String
  body        String
  readAt      DateTime?
  createdAt   DateTime           @default(now())
  listing     MarketplaceListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  sender      User               @relation("MarketSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient   User               @relation("MarketRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId, createdAt])
  @@index([listingId])
  @@index([senderId, createdAt])
}

model CommunityPost {
  id        String             @id @default(cuid())
  authorId  String
  category  String             @default("general") // general | prospecting | brokers | loads | compliance | tools | wins
  title     String
  body      String
  status    String             @default("published") // published | hidden | removed
  pinned    Boolean            @default(false)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  author    User               @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments  CommunityComment[]
  reports   ContentReport[]

  @@index([status, category, createdAt])
  @@index([authorId])
  @@index([status, pinned, createdAt])
}

model CommunityComment {
  id        String             @id @default(cuid())
  postId    String
  authorId  String
  parentId  String?
  body      String
  status    String             @default("published")
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  post      CommunityPost      @relation(fields: [postId], references: [id], onDelete: Cascade)
  author    User               @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent    CommunityComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   CommunityComment[] @relation("CommentReplies")
  reports   ContentReport[]

  @@index([postId, createdAt])
  @@index([authorId])
  @@index([parentId])
}

model ContentReport {
  id           String              @id @default(cuid())
  reporterId   String
  listingId    String?
  postId       String?
  commentId    String?
  reason       String // spam | scam | abuse | inappropriate | other
  details      String?
  status       String              @default("open") // open | resolved | dismissed
  resolvedById String?
  resolvedAt   DateTime?
  createdAt    DateTime            @default(now())
  reporter     User                @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  resolvedBy   User?               @relation("Resolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  listing      MarketplaceListing? @relation(fields: [listingId], references: [id], onDelete: Cascade)
  post         CommunityPost?      @relation(fields: [postId], references: [id], onDelete: Cascade)
  comment      CommunityComment?   @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([listingId])
  @@index([postId])
  @@index([commentId])
  @@index([reporterId])
}

// ---------------------------------------------------------------------------
// AI
// ---------------------------------------------------------------------------

model AIConversation {
  id        String      @id @default(cuid())
  userId    String
  title     String      @default("New conversation")
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  AIMessage[]

  @@index([userId, updatedAt])
}

model AIMessage {
  id             String         @id @default(cuid())
  conversationId String
  role           String // user | assistant
  content        String
  sources        String? // JSON array [{title,url,date,kind}]
  createdAt      DateTime       @default(now())
  conversation   AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model AIKnowledgeDocument {
  id           String             @id @default(cuid())
  ownerId      String
  sizeBytes    Int                @default(0) // stored file size, so storage use is one SUM instead of reading the disk
  scope        String             @default("private") // private (owner only) | global (admin-approved, everyone)
  approved     Boolean            @default(true)
  title        String
  originalName String
  storedName   String             @unique
  mimeType     String
  status       String             @default("processing") // processing | ready | error
  error        String?
  chunkCount   Int                @default(0)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  owner        User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  chunks       AIKnowledgeChunk[]

  @@index([ownerId])
  @@index([scope, approved])
}

model AIKnowledgeChunk {
  id         String              @id @default(cuid())
  documentId String
  idx        Int
  content    String
  embedding  String? // JSON float array when an embeddings model is configured
  document   AIKnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, idx])
}

// ---------------------------------------------------------------------------
// Automation, notifications, audit, settings
// ---------------------------------------------------------------------------

model Automation {
  id           String    @id @default(cuid())
  ownerId      String
  name         String
  trigger      String // carrier_created | stage_changed | call_outcome
  triggerValue String? // stage key or call outcome
  action       String // create_follow_up | enroll_sequence | move_stage | add_tag | notify
  actionValue  String? // stage key / sequence id / tag name / note text
  delayDays    Int       @default(0)
  active       Boolean   @default(true)
  runCount     Int       @default(0)
  lastRunAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  owner        User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId, trigger, active])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String?
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@index([userId, createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String?
  entityId   String?
  ip         String?
  details    String?
  createdAt  DateTime @default(now())
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([actorId])
  @@index([action])
}

model SystemSetting {
  key         String   @id
  value       String
  secret      Boolean  @default(false) // value is AES-GCM encrypted
  updatedById String?
  updatedAt   DateTime @updatedAt
  updatedBy   User?    @relation(fields: [updatedById], references: [id], onDelete: SetNull)
}

/**
 * Saved lead-generation profile: FMCSA Census criteria that produce fresh, de-duplicated leads on demand or on a schedule.
 */
model LeadGenerator {
  id         String       @id @default(cuid())
  ownerId    String
  name       String
  criteria   String // JSON: states, cargo, fleet, authority age, contact requirements
  batchSize  Int          @default(25)
  stageKey   String       @default("lead")
  listId     String? // prospect list new leads are added to
  sequenceId String? // sequence new leads are enrolled in
  minScore   Int          @default(0)
  autoRun    Boolean      @default(false)
  frequency  String       @default("daily") // daily | weekly
  nextRunAt  DateTime?
  lastRunAt  DateTime?
  // JSON: per-state crawl position { v, criteriaHash, states: { TX: { deepOffset, headSeenAt, exhaustedAt } } } (services/leadgen.js)
  cursor     String?
  active     Boolean      @default(true)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  owner      User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  runs       LeadGenRun[]

  @@index([ownerId])
  @@index([autoRun, nextRunAt])
}

model LeadGenRun {
  id          String         @id @default(cuid())
  generatorId String?
  ownerId     String
  trigger     String         @default("manual") // manual | scheduled
  status      String         @default("ok") // ok | limited | exhausted | error
  scanned     Int            @default(0)
  created     Int            @default(0)
  skipped     Int            @default(0)
  belowScore  Int            @default(0)
  carrierIds  String         @default("[]") // JSON array of created carrier ids
  message     String?
  // JSON: candidates left out per reason { inactiveAuthority, sharedContact, unsafe, outOfService, filtered, teamClaimed, suppressed }
  exclusions  String?
  createdAt   DateTime       @default(now())
  generator   LeadGenerator? @relation(fields: [generatorId], references: [id], onDelete: SetNull)
  owner       User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId, createdAt])
  @@index([generatorId, createdAt])
}

/**
 * Consent-based live location: a driver opens a secret link on their phone and shares GPS while the page is open.
 */
model LocationShare {
  id             String         @id @default(cuid())
  carrierId      String
  ownerId        String
  tokenHash      String         @unique // sha256 of the link token; the token itself is never stored
  driverName     String?
  driverPhone    String?
  loadId         String? // trip shown to the driver
  status         String         @default("pending") // pending | sharing | paused | stopped | expired | locked
  consentAt      DateTime?
  expiresAt      DateTime // before the first device claims the link this is the claim deadline; then claim time + durationHours
  durationHours  Int            @default(24)
  claimMinutes   Int            @default(120) // the link must be opened within this window or it expires
  // Anti-forwarding: the link is bound to the first phone that claims it (only a hash of the device secret is kept).
  deviceHash     String?
  deviceLabel    String? // e.g. "iPhone · Safari"
  deviceKind     String? // mobile | desktop | unknown
  deviceBoundAt  DateTime?
  firstBoundAt   DateTime?
  firstSeenIp    String? // coarse only (/24 or /48), never the full address
  pinHash        String? // HMAC of the 6-digit PIN keyed with the app secret; null = no PIN on this link
  pinAttempts    Int            @default(0)
  pinVerifiedAt  DateTime?
  flags          String         @default("[]") // JSON [{ type, at, detail }], newest first, max 50
  lastPingFlags  String? // comma-separated flags of the latest fix
  lastAlertAt    DateTime? // throttles security notifications (other device, locked) to the dispatcher
  lastGpsAlertAt DateTime? // separate throttle for GPS plausibility notifications
  trustedLat     Float? // last fix that passed the plausibility checks
  trustedLng     Float?
  trustedAt      DateTime?
  lastLat        Float?
  lastLng        Float?
  lastAccuracy   Float?
  lastSpeed      Float?
  lastHeading    Float?
  lastAt         DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  carrier        Carrier        @relation(fields: [carrierId], references: [id], onDelete: Cascade)
  owner          User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  pings          LocationPing[]

  @@index([carrierId, status])
  @@index([ownerId])
}

model LocationPing {
  id       String        @id @default(cuid())
  shareId  String
  lat      Float
  lng      Float
  accuracy Float?
  speed    Float?
  heading  Float?
  flags    String? // comma-separated trust flags (impossible_jump, low_accuracy, desktop, stale_clock, far_from_trip)
  at       DateTime      @default(now())
  share    LocationShare @relation(fields: [shareId], references: [id], onDelete: Cascade)

  @@index([shareId, at])
  @@index([at])
}

/**
 * Text-message (SMS / Google Voice) templates. Texts are never sent automatically: they are copied and opened by the user.
 */
model TextTemplate {
  id         String    @id @default(cuid())
  ownerId    String
  name       String
  body       String
  category   String    @default("carrier") // carrier | broker | driver | follow_up | other
  starterKey String?
  useCount   Int       @default(0)
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  owner      User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId, category])
  @@index([ownerId, starterKey])
}

/**
 * Web Push subscription (one per browser/device).
 */
model PushSubscription {
  id         String    @id @default(cuid())
  userId     String
  endpoint   String    @unique
  p256dh     String
  auth       String
  userAgent  String?
  failures   Int       @default(0)
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/**
 * Timeline of a load: check-ins, check calls, detention start/stop, documents, status changes.
 */
model LoadEvent {
  id        String   @id @default(cuid())
  loadId    String
  ownerId   String
  type      String // arrived_pickup | loaded | departed_pickup | arrived_delivery | delivered | issue | check_call | detention_start | detention_stop | document | status | note
  at        DateTime @default(now())
  lat       Float?
  lng       Float?
  note      String?
  source    String   @default("dispatcher") // dispatcher | driver_link | broker_link | system
  data      String? // JSON extras (document id, old/new status, etc.)
  createdAt DateTime @default(now())
  load      Load     @relation(fields: [loadId], references: [id], onDelete: Cascade)
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([loadId, at])
  @@index([ownerId, at])
}

/**
 * Read-only tracking link for the broker/shipper of one load (no driver identity, no CRM data).
 */
model LoadShare {
  id           String    @id @default(cuid())
  loadId       String
  ownerId      String
  tokenHash    String    @unique
  label        String? // e.g. broker name
  expiresAt    DateTime
  revokedAt    DateTime?
  views        Int       @default(0)
  lastViewedAt DateTime?
  createdAt    DateTime  @default(now())
  load         Load      @relation(fields: [loadId], references: [id], onDelete: Cascade)
  owner        User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([loadId])
  @@index([ownerId])
}

/**
 * Invoices: freight invoices to brokers (on behalf of the carrier) and dispatch-fee invoices to carriers.
 */
model Invoice {
  id             String    @id @default(cuid())
  ownerId        String
  number         Int // per-owner sequence
  kind           String    @default("freight") // freight | dispatch_fee
  status         String    @default("draft") // draft | sent | partial | paid | void
  loadId         String?
  carrierId      String?
  brokerId       String?
  billToName     String
  billToEmail    String?
  lines          String // JSON [{description, quantity, unitCents, amountCents}]
  amountCents    Int
  paidCents      Int       @default(0)
  issuedAt       DateTime?
  dueAt          DateTime?
  sentAt         DateTime?
  paidAt         DateTime?
  notes          String?
  reminderCount  Int       @default(0)
  lastReminderAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  owner          User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  load           Load?     @relation(fields: [loadId], references: [id], onDelete: SetNull)
  carrier        Carrier?  @relation(fields: [carrierId], references: [id], onDelete: SetNull)
  broker         Broker?   @relation(fields: [brokerId], references: [id], onDelete: SetNull)

  @@unique([ownerId, number])
  @@index([ownerId, status, dueAt])
  @@index([loadId])
  @@index([carrierId])
  @@index([brokerId])
  @@index([ownerId, brokerId, paidAt])
}

// ---------------------------------------------------------------------------------------------------------------
// Carrier accounts: a profile owned by the carrier (one per USDOT number), not by any dispatcher. The carrier proves it
// controls the USDOT number with a code sent to the email FMCSA has on file, keeps its documents once, and decides
// per dispatcher what to share. A dispatcher sees only its own share; it never learns which other dispatchers the
// carrier works with.
// ---------------------------------------------------------------------------------------------------------------

model CarrierAccount {
  id            String                 @id @default(cuid())
  dotNumber     String                 @unique
  legalName     String?
  verifiedEmail String? // the FMCSA-registered email the last sign-in code went to (lower case)
  verifiedAt    DateTime?
  lastLoginAt   DateTime?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  sessions      CarrierSession[]
  documents     CarrierVaultDocument[]
  shares        CarrierShare[]
}

model CarrierLoginCode {
  id        String    @id @default(cuid())
  dotNumber String
  email     String
  codeHash  String
  attempts  Int       @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  ip        String?
  createdAt DateTime  @default(now())

  @@index([dotNumber, createdAt])
  @@index([expiresAt])
}

model CarrierSession {
  id         String         @id @default(cuid())
  accountId  String
  tokenHash  String         @unique
  expiresAt  DateTime
  lastSeenAt DateTime       @default(now())
  userAgent  String?
  createdAt  DateTime       @default(now())
  account    CarrierAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([expiresAt])
}

model CarrierVaultDocument {
  id           String            @id @default(cuid())
  accountId    String
  type         String // w9 | coi | mc_authority | noa | voided_check | cdl | registration | other
  originalName String
  storedName   String            @unique
  mimeType     String
  sizeBytes    Int
  expiresAt    DateTime? // insurance certificates, CDL, registrations
  replacedAt   DateTime? // a newer upload of the same type took its place
  createdAt    DateTime          @default(now())
  account      CarrierAccount    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  sharedCopies CarrierShareDoc[]

  @@index([accountId, type])
}

/**
 * What one carrier shares with one dispatcher (the dispatcher's own carrier record).
 */
model CarrierShare {
  id         String            @id @default(cuid())
  accountId  String
  carrierId  String // the dispatcher's Carrier row
  ownerId    String // the dispatcher who owns that row
  docTypes   String            @default("") // comma list of document types the carrier shares
  autoUpdate Boolean           @default(true) // newer uploads of those types go to this dispatcher too
  hidden     Boolean           @default(false) // the carrier says it does not work with this dispatcher
  revokedAt  DateTime?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  account    CarrierAccount    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  carrier    Carrier           @relation(fields: [carrierId], references: [id], onDelete: Cascade)
  owner      User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  files      CarrierShareDoc[]

  @@unique([accountId, carrierId])
  @@index([ownerId])
  @@index([carrierId])
}

/**
 * A vault document copied into a dispatcher's documents through a share (one copy per share and document).
 */
model CarrierShareDoc {
  id              String               @id @default(cuid())
  shareId         String
  vaultDocumentId String
  documentId      String               @unique
  createdAt       DateTime             @default(now())
  share           CarrierShare         @relation(fields: [shareId], references: [id], onDelete: Cascade)
  vaultDocument   CarrierVaultDocument @relation(fields: [vaultDocumentId], references: [id], onDelete: Cascade)
  document        Document             @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([shareId, vaultDocumentId])
  @@index([vaultDocumentId])
}
