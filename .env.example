# Copy to .env and adjust. Every value is optional unless marked REQUIRED for production.
# Integration credentials can also be entered later in Admin → Settings (stored encrypted in the database).
# Database values take precedence over these environment defaults.

# ---- Core ---------------------------------------------------------------
# Public URL used in email links and OAuth redirects. REQUIRED for production.
APP_URL=http://localhost:3000
# Host port published by docker compose
HOST_PORT=3000
# 32+ random characters. If omitted, one is generated and persisted in /data/.app_secret.
# Changing it invalidates encrypted credentials and sessions.
APP_SECRET=
# Set true when serving over HTTPS (auto-enabled when APP_URL starts with https)
COOKIE_SECURE=
SESSION_DAYS=14
MAX_UPLOAD_MB=15
# Number of reverse proxies in front of the app (for correct client IPs / rate limits)
TRUST_PROXY=1

# ---- Initial super admin (created on first start if the email doesn't exist) ----
# Set both before first start. Use a strong password (8+ chars, letters and digits).
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator

# ---- Platform email (verification, password reset, invitations) ----------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="DispatchDesk <no-reply@example.com>"
# Daily cap on platform email, shared by all users (default 300, the Brevo free tier). Admin → System settings → Email
# overrides it. Verification, password-reset and invitation mail keep a reserve (default 30% of the cap); notices and
# the daily digest use the rest. Admin → Setup shows today's count.
PLATFORM_MAIL_DAILY_LIMIT=
PLATFORM_MAIL_AUTH_RESERVE=

# ---- AI dispatcher (any OpenAI-compatible API) ---------------------------
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
# Optional: enables vector retrieval for the knowledge base (otherwise keyword retrieval)
AI_EMBEDDING_MODEL=
# Optional web research for the AI: tavily | brave
SEARCH_PROVIDER=
SEARCH_API_KEY=

# ---- Billing (Stripe test mode) -------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Set each plan's Stripe Price ID in Admin → Plans.

# ---- Mailbox OAuth (users connect their own mailboxes) --------------------
# Redirect URIs to register: ${APP_URL}/api/email/oauth/gmail/callback and ${APP_URL}/api/email/oauth/outlook/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common

# ---- Carrier data ----------------------------------------------------------
# FMCSA Company Census (data.transportation.gov) works without a key; an app token raises rate limits.
SOCRATA_APP_TOKEN=
# FMCSA QCMobile web key (https://mobile.fmcsa.dot.gov/QCDevsite/) for authority/safety enrichment
FMCSA_WEBKEY=

# ---- Push notifications (phone and desktop) -----------------------------------
# Works without setup: a VAPID key pair is generated on first use and stored encrypted in the database.
# Set both keys to use your own pair (`cd server && npx web-push generate-vapid-keys`). After a key change, people
# turn push on again on each device. The server needs outbound HTTPS to the browser push services
# (fcm.googleapis.com, *.push.services.mozilla.com, web.push.apple.com, *.notify.windows.com).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact sent to push services: an https:// URL or a mailto: address.
# Default: APP_URL when it is https, else mailto:ADMIN_EMAIL.
VAPID_SUBJECT=
# Extra push service hostnames to accept, comma-separated (only for browsers with another push service)
PUSH_EXTRA_HOSTS=

# ---- Calendar feeds ---------------------------------------------------------
# Requests per minute per IP address to private calendar feed links (default 60)
CALENDAR_FEED_RATE_LIMIT=

# ---- Tuning (defaults suit one small VPS) -------------------------------------
# true skips the Brotli/gzip pass over client bundles after each deploy (the Docker image already does it at build time)
DISABLE_PRECOMPRESS=
# Password hashing worker threads per process (default 2 on 4+ CPU cores, else 1) and queued hashes (default 200)
PASSWORD_HASH_THREADS=
PASSWORD_HASH_QUEUE=
# Interval of the scheduler's slow loop (lead generators and other slow jobs), in ms (default 60000)
SCHEDULER_SLOW_INTERVAL_MS=

# ---- Rate limits (requests per window; blank uses the default) -----------------
# Per network address before the session lookup, per minute (default 3000)
RATE_LIMIT_IP_PER_MIN=
# Per signed-in user or API token, per minute (default 600)
RATE_LIMIT_USER_PER_MIN=
# Sign-in and password reset per 15 minutes: per network address (default 200) and per address + email (default 20)
RATE_LIMIT_AUTH_IP=
RATE_LIMIT_AUTH_ACCOUNT=
# Endpoints that send a platform email, per hour: per network address (default 30) and per account (default 5)
RATE_LIMIT_MAIL_IP=
RATE_LIMIT_MAIL_ACCOUNT=
# New accounts per network address per hour (default 30)
RATE_LIMIT_REGISTER_IP=
# Public tracking, portal and calendar links, per link per minute (default 120)
RATE_LIMIT_LINK_PER_MIN=
# File uploads per user (or per driver link) per minute (default 30)
RATE_LIMIT_UPLOADS_PER_MIN=

# ---- File storage per account, in MB (documents, avatars, knowledge files, listing images) ----
# Free plan (default 500), any paid individual plan (default 5120), Teams plans per member, pooled (default 20480)
STORAGE_FREE_MB=
STORAGE_PAID_MB=
STORAGE_TEAM_MB_PER_MEMBER=

# ---- Development only -------------------------------------------------------
# Return email verification / reset tokens in API responses (NEVER enable in production)
EXPOSE_DEV_TOKENS=false
DISABLE_SCHEDULER=false
